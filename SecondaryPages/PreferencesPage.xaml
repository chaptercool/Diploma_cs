<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diploma_cs.SecondaryPages.PreferencesPage">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackProperties}">
            <Label Text="Preferencje" Style="{StaticResource Heading1}"/>
            <Border
                Padding="10"
                StrokeShape="RoundRectangle 10"
                Background="Transparent"
                Stroke="{StaticResource Gray200}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEditPersonalDataTapped" />
                </Border.GestureRecognizers>
                <Grid
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="5">
                    <Label Text="Edytuj dane osobowe" Style="{StaticResource Heading3}" Grid.Row="0" Grid.Column="0"/>
                    <Label Text="Zmień swoje dane, takie jak imię, wiek i płeć" Style="{StaticResource AdditionalText}" Grid.Row="1" Grid.Column="0"/>
                    <Image Source="roundarrowright.png" HeightRequest="25" Grid.RowSpan="2" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <Border
                Padding="10"
                StrokeShape="RoundRectangle 10"
                Background="Transparent"
                Stroke="{StaticResource Gray200}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                </Border.GestureRecognizers>
                <Grid
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="5">
                    <Label Text="Powiadomienia" Style="{StaticResource Heading3}" Grid.Row="0" Grid.Column="0"/>
                    <Label Text="Zarządzaj powiadomieniami w aplikacji" Style="{StaticResource AdditionalText}" Grid.Row="1" Grid.Column="0"/>
                    <Image Source="roundarrowright.png" HeightRequest="25" Grid.RowSpan="2" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>