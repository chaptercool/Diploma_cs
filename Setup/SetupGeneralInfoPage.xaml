<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diploma_cs.Setup.SetupGeneralInfoPage"
             Shell.TabBarIsVisible="False">
    <VerticalStackLayout Style="{StaticResource VerticalStackProperties}">
        <Label Text="Powiedz coś o sobie" Style="{StaticResource Heading1}" HorizontalOptions="Center" HorizontalTextAlignment="Center" VerticalOptions="Start"/>
        <Image Source="zamknikcie.png" MaximumHeightRequest="150" HorizontalOptions="Center" VerticalOptions="Center"/>
        
        <Label Text="Jak masz na imię?" Style="{StaticResource AdditionalText}"/>
        <Border Style="{StaticResource RoundedEntryFrame}">
            <Entry x:Name="UserName"
               Style="{StaticResource EntryInRoundedFrame}"
               Placeholder="Twoje imię"
               Keyboard="Text"
               ReturnType="Next"/>
        </Border>

        <Label Text="Ile masz lat?" Style="{StaticResource AdditionalText}"/>
        <Border Style="{StaticResource RoundedEntryFrame}">
            <Entry x:Name="UserAge"
               Style="{StaticResource EntryInRoundedFrame}"
               Placeholder="Twoje imię"
               Keyboard="Numeric"
               ReturnType="Done"/>
        </Border>

        <Label Text="Kim jesteś?" Style="{StaticResource AdditionalText}"/>
        <Border Style="{StaticResource RoundedEntryFrame}">
            <Picker x:Name="UserGender"
                Title="Twoja płeć"
                Style="{StaticResource Dropdown}">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Kobieta</x:String>
                    <x:String>Mężczyzna</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
        </Border>

        <Button Text="Dalej" Style="{StaticResource PrimaryButton}" Clicked="OnNextButtonClicked"/>


    </VerticalStackLayout>
</ContentPage>