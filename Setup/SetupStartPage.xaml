<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diploma_cs.Setup.SetupStartPage"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
             droid:NavigationBar.Color="White"
             droid:NavigationBar.Style="Default"
             Shell.TabBarIsVisible="False">
    <ContentPage.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="Transparent" StatusBarStyle="DarkContent"/>
    </ContentPage.Behaviors>
    <VerticalStackLayout Style="{StaticResource VerticalStackProperties}" VerticalOptions="Center">
        <Image 
            Source="lung.png"
            MaximumHeightRequest="150"
            MaximumWidthRequest="150"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
        <Label Text="DropNow" Style="{StaticResource Heading1}" HorizontalOptions="Center"/>
        <Label Text="Jesteś gotowy stać zdrowszym?" Style="{StaticResource AdditionalText}" HorizontalOptions="Center" Margin="0, 0, 0, 10"/>

        <Button Style="{StaticResource PrimaryButton}" Text="Start" WidthRequest="200" Margin="0, 5, 0, 0" Clicked="OnStartClicked"/>
    </VerticalStackLayout>
</ContentPage>